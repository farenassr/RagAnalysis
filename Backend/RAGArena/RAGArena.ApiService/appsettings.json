{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:5173",
    "http://localhost:3000"
  ],
  "Storage": {
    "BasePath": "uploads"
  },
  "Langfuse": {
    "Enabled": false,
    "PublicKey": "",
    "SecretKey": "",
    "BaseUrl": "https://cloud.langfuse.com"
  },
  "LlamaParse": {
    "ApiKey": "",
    "BaseUrl": "https://api.cloud.llamaindex.ai",
    "PollingIntervalMs": 2000,
    "MaxPollingAttempts": 60,
    "Language": "en",
    "ResultType": "markdown"
  },
  "OpenAI": {
    "ApiKey": "",
    "BaseUrl": "https://api.openai.com/v1/",
    "DefaultModel": "text-embedding-3-small",
    "ChatModel": "gpt-4o-mini",
    "BatchSize": 20,
    "RetrievedChunkCount": 5,
    "DenseRetrievalWeight": 0.7,
    "LexicalRetrievalWeight": 0.3
  },
  "Chunking": {
    "MaxChunkSize": 512,
    "ChunkOverlap": 50,
    "SemanticBreakpointThreshold": 0.3,
    "SemanticWindowSize": 3
  }
}
